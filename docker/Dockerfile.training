# Training image for LeRobot. Derived from Dockerfile.internal but trimmed
# to training-relevant extras.
#
# Usage:
#   docker build -f docker/Dockerfile.training -t lerobot-training:dev .
#   docker run --rm --gpus all --init \
#     -v ~/.cache/huggingface:/home/user_lerobot/.cache/huggingface \
#     -v $PWD/outputs:/lerobot/outputs \
#     lerobot-training:dev \
#     lerobot-train --policy.type=act --dataset.repo_id=lerobot/pusht --steps=10
#
# Signal handling: we rely on `docker run --init` (Docker's built-in tini)
# to be PID 1. We do NOT set an ENTRYPOINT here — nesting our own tini
# under Docker's --init tini produces a "Tini is not running as PID 1"
# warning at runtime. Pick one: leave it to the docker invocation, which
# is more portable across hosts and works correctly when our image is
# pulled by tools that don't know about our internal conventions.

ARG CUDA_VERSION=12.4.1
ARG OS_VERSION=22.04
FROM nvidia/cuda:${CUDA_VERSION}-base-ubuntu${OS_VERSION}

ARG PYTHON_VERSION=3.12

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=egl \
    PATH=/lerobot/.venv/bin:$PATH \
    DEVICE=cuda

# System deps + Python + uv.
# Note: we don't install tini here — signal handling is delegated to
# `docker run --init` which provides Docker's own minimal init as PID 1.
# Nesting our own tini under that produced a runtime "Tini is not running
# as PID 1" warning during the smoke test on 2026-06-04.
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common build-essential git curl \
    libglib2.0-0 libgl1-mesa-glx libegl1-mesa ffmpeg \
    libgeos-dev cmake pkg-config ninja-build \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       python${PYTHON_VERSION} \
       python${PYTHON_VERSION}-venv \
       python${PYTHON_VERSION}-dev \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && useradd --create-home --shell /bin/bash user_lerobot \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /lerobot
RUN chown -R user_lerobot:user_lerobot /lerobot
USER user_lerobot

ENV HOME=/home/user_lerobot \
    HF_HOME=/home/user_lerobot/.cache/huggingface \
    HF_LEROBOT_HOME=/home/user_lerobot/.cache/huggingface/lerobot \
    TORCH_HOME=/home/user_lerobot/.cache/torch \
    TRITON_CACHE_DIR=/home/user_lerobot/.cache/triton

RUN uv venv --python python${PYTHON_VERSION}

# Dependencies install BEFORE any project source is copied, and this ordering
# is load-bearing: Docker keys a layer on the content of what it copies, so
# anything copied above the sync below re-couples the ~24-minute dependency
# install to files that change constantly. Only the two files that actually
# declare dependencies belong here. `tests/gui/training/test_image_layers.py`
# enforces that; see issue #98 for the measurement.
COPY --chown=user_lerobot:user_lerobot pyproject.toml uv.lock ./

# The single `training-image` extra (defined in pyproject.toml's fork-only
# section) is the source of truth for "what this Docker image needs at
# runtime". Adding a new policy = one line in `training-image`; this
# Dockerfile is unchanged. Centralising the contract there means CI image
# rebuilds pick up new policy deps automatically — no more SmolVLA-style
# "I forgot --extra smolvla here" bugs.
#
# --no-install-project is what makes the split possible: it installs the
# dependency closure without needing the project's own source present, so this
# layer contains no first-party code and therefore cannot go stale against it.
RUN uv sync --locked --extra training-image --no-cache --no-install-project

# ── GPU video decode: torchcodec CUDA + NVDEC prerequisites ──────────────────
# The locked torchcodec is the +cpu wheel; the +cu128 variant of the SAME
# version adds the CUDA device interface (--data-path gpu). Its chain, each
# link established empirically in this container on 2026-08-22: libnppicc from
# nvidia-npp-cu12 (preloaded at runtime by lerobot.datasets.gpu_data_pipeline),
# and ffmpeg >= 5 shared libraries — Ubuntu 22.04 ships 4, whose AV1 NVDEC
# path fails with "Function not implemented". The BtbN n8.1 build tracks the
# 8.1 patch line rather than pinning a byte-exact archive; decode output is
# unaffected (AV1/H.264 decode is bit-exact by spec). The container must also
# run with NVIDIA_DRIVER_CAPABILITIES including "video" (the orchestrator
# sets it) or libnvcuvid is never mounted. The version here must match
# uv.lock's linux torchcodec — tests/gui/training/test_image_layers.py pins
# that, so a lock upgrade that forgets this line fails a test instead of
# silently shipping a CPU-only decoder next to a GPU flag.
USER root
RUN curl -LsSf -o /tmp/ff8.tar.xz \
    https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n8.1-latest-linux64-gpl-shared-8.1.tar.xz \
    && mkdir -p /opt/ffmpeg8 && tar xf /tmp/ff8.tar.xz -C /opt/ffmpeg8 --strip-components=1 \
    && rm /tmp/ff8.tar.xz
USER user_lerobot
ENV LD_LIBRARY_PATH=/opt/ffmpeg8/lib

# The project installs in its own cheap layer. A code-only rebuild invalidates
# from here down and reuses everything above, so it never re-downloads Torch or
# the NVIDIA wheels. `uv sync` installs the project editable (a .pth pointing at
# /lerobot/src), which is why the copied source is what actually executes.
COPY --chown=user_lerobot:user_lerobot setup.py README.md MANIFEST.in ./
COPY --chown=user_lerobot:user_lerobot src/ src/
RUN uv sync --locked --extra training-image --no-cache

# AFTER the final sync, deliberately: `uv sync --locked` reconciles the venv
# to the lock exactly, so an out-of-lock install placed above it is silently
# reverted — which is precisely how the first image with this layer shipped
# the +cpu decoder anyway (caught by the trainer's startup probe, not by the
# build). Two installs on purpose: --index-url REPLACES PyPI, and
# nvidia-npp-cu12 exists only on PyPI.
RUN uv pip install --index-url https://download.pytorch.org/whl/cu128 "torchcodec==0.11.1+cu128" \
    && uv pip install nvidia-npp-cu12

# Build-time sanity check: every registered policy's modeling module must
# import in this image. Catches mis-pinned transitive deps (e.g. a future
# transformers bump dropping num2words) at BUILD time, where it costs
# seconds of CI, instead of at the user's pod (where it costs GPU minutes
# + pull/push wall-clock + cloud $). The probe lives in
# lerobot.policies.factory and is shared with the GUI startup health check.
RUN python -c "from lerobot.policies.factory import check_policy_registry_health as h; b={k:v for k,v in h().items() if v}; assert not b, f'unimportable policies in training image (build fails): {b}'"

# Triton ptxas binary needs +x for some torch.compile paths
RUN chmod +x /lerobot/.venv/lib/python${PYTHON_VERSION}/site-packages/triton/backends/nvidia/bin/ptxas || true

# No ENTRYPOINT — `docker run --init` provides Docker's tini as PID 1.
# That covers signal propagation without producing the "Tini is not
# running as PID 1" warning we saw with a nested tini.

# Default to bash; deploy scripts override with `lerobot-train ...`
CMD ["/bin/bash"]
